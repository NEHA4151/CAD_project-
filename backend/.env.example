# ============================================================
# Personal Finance Tracker — Backend Environment Variables
# Copy this file to .env and fill in your actual values.
# NEVER commit the actual .env file.
# ============================================================

# Server
PORT=5000

# JWT signing secret — use a strong random string in production
JWT_SECRET=your-strong-random-secret-here

# CORS — set to your frontend origin (ALB DNS or frontend EC2 IP)
FRONTEND_URL=http://localhost:3000

# ── PostgreSQL RDS (required for AWS EC2 + RDS deployment) ──────────────────
# Format: postgresql://<user>:<password>@<rds-endpoint>:5432/<dbname>
# Leave empty to use local JSON file storage (development only)
DATABASE_URL=

# ── Supabase Auth (optional — only needed if using Supabase signup flow) ────
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key
